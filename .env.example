# ─── AI Provider ─────────────────────────────────────────────────────────────
# Choose one of the configurations below. GEMINI_API_TOKEN is only required when
# OPENCODE_MODEL starts with "google/". Ollama needs no API key.

# Option A: Gemini cloud model (default)
GEMINI_API_TOKEN=your-google-ai-studio-api-key

# Option B: Local Ollama model running on the host machine
# The container reaches the host via host.docker.internal (port 11434 by default).
# Ensure Ollama is running on the host and the model is pulled before starting.
#   ollama pull qwen2.5-coder:14b
# OLLAMA_HOST=http://host.docker.internal:11434

# Option C: Ollama primary with Gemini cloud fallback
# GEMINI_API_TOKEN=your-google-ai-studio-api-key
# OLLAMA_HOST=http://host.docker.internal:11434

# ─── GitHub ──────────────────────────────────────────────────────────────────
# PAT needs: repo, issues:write, pull_requests:write
GH_TOKEN=your-github-personal-access-token
GITHUB_OWNER=cairocoder01

# ─── Issue Lifecycle Labels ───────────────────────────────────────────────────
# Issues with TRIGGER_LABEL are picked up by the worker
TRIGGER_LABEL=dt-agent-build
# Applied immediately when the worker claims an issue (prevents double-pickup across container runs)
PROCESSING_LABEL=dt-agent-processing
# Applied when agent needs human clarification before continuing
WAITING_LABEL=dt-agent-waiting-for-human
# Applied when all verify stages pass and a PR has been opened
READY_LABEL=ready-for-human-review

# ─── Loop Control ─────────────────────────────────────────────────────────────
# Maximum number of execute→verify iterations before giving up
MAX_LOOP_RETRIES=5
# A PR delivered as ready-for-review but with FAILING GitHub checks is auto-picked
# (highest priority) and reworked. This bounds how many times the agent may auto-retry
# such a PR before handing it to a human (WAITING_LABEL). Reset when a human re-applies
# TRIGGER_LABEL. Optional; defaults to 3 if unset.
MAX_CI_FIX_ATTEMPTS=3
# Seconds before opencode is killed and the run is marked BLOCKED (0 = no timeout)
AGENT_TIMEOUT=1800
# Set to true to run all stages without any GitHub writes (push, PR, label mutations).
# Useful for local testing. See tests/run_stage.sh for per-stage development.
DRY_RUN=false
# Log files older than this many days are deleted at the start of each container run.
LOG_RETENTION_DAYS=30
# Seconds to sleep between polls when no issues are found.
# This is the effective cron interval: the worker sleeps this long when idle,
# then Docker restarts it. When work is found it runs immediately (no sleep).
IDLE_SLEEP=900

# ─── WordPress Test Database ─────────────────────────────────────────────────
# When using docker-compose.yml, WP_DB_HOST is set automatically to "mysql" (the
# linked service) and does not need to be set here. Override only if running the
# worker against an external MySQL instance.
# WP_DB_HOST=host.docker.internal
WP_DB_NAME=wordpress_test
WP_DB_USER=wp
WP_DB_PASS=wp
# Root password for the mysql service (docker-compose only)
MYSQL_ROOT_PASSWORD=rootpass

# ─── Optional Overrides ───────────────────────────────────────────────────────
# WordPress version to install for testing
WP_VERSION=latest

# Branch that PRs should target (auto-detected from remote if blank: develop → main → master)
BASE_BRANCH=

# opencode model in provider/model format — used by all stages unless overridden below.
# Cloud examples:  google/gemini-3-flash-preview, anthropic/claude-3-5-sonnet-20241022
# Local examples:  ollama/qwen3.5:27b, ollama/llama3.2, ollama/deepseek-coder-v2
OPENCODE_MODEL=google/gemini-3.1-flash-lite

# Per-stage model overrides (optional). When set, these take precedence over OPENCODE_MODEL
# for their respective stage. Leave blank to use OPENCODE_MODEL for both stages.
#
# Planning only needs to read files and produce a structured markdown document — a fast,
# cheap model works well. Execution must write code, run shell commands, and iterate on
# errors, so a more capable model pays off there.
#
# Example: fast cloud model for planning, powerful local model for execution:
# OPENCODE_PLAN_MODEL=google/gemini-3-flash-preview
# OPENCODE_EXECUTE_MODEL=ollama/qwen3.5:27b-mlx
OPENCODE_PLAN_MODEL=
OPENCODE_EXECUTE_MODEL=

# Comma-separated fallback models tried in order when the primary hits a rate limit
# or a connection error. Leave empty to disable fallback.
# Mix providers freely — each needs its own API key / host configured above.
# Example (cloud fallback):  OPENCODE_FALLBACK_MODELS=google/gemini-2.5-pro,anthropic/claude-sonnet-4-5
# Example (Ollama primary, cloud fallback): set OPENCODE_MODEL=ollama/qwen2.5-coder:14b
#   then: OPENCODE_FALLBACK_MODELS=google/gemini-2.0-flash
OPENCODE_FALLBACK_MODELS=google/gemini-3.1-flash-lite

# ─── Base WordPress Theme ─────────────────────────────────────────────────────
# Bootstrap hook (03_install_base_theme.sh) installs the latest release of this
# theme into the WordPress test install. Override if you maintain a fork.
# When TARGET_REPO matches this theme, the agent's own changes are used instead.
DT_BASE_THEME_REPO=DiscipleTools/disciple-tools-theme

# ─── E2E Verification ────────────────────────────────────────────────────────
# 02b_prep_e2e_site.sh starts a PHP built-in server inside the worker container
# and serves the WordPress test install at this URL before 03_chrome_mcp_e2e.js runs.
# Change WP_E2E_PORT if 8080 conflicts with something on your host.
WP_TEST_URL=http://localhost:8080
WP_E2E_PORT=8080

# ─── WordPress Options Injection ─────────────────────────────────────────────
# Path INSIDE the container to a KEY=VALUE file written to wp_options before each issue.
# To use: create your secrets file, add a volume mount in docker-compose.yml pointing
# the host file to /run/secrets/wp-options, then set this to /run/secrets/wp-options.
# Each line: OPTION_NAME=value  (lines starting with # are ignored)
WP_OPTIONS_FILE=

# ─── Timezone ──────────────────────────────────────────────────────────────
# Set the timezone for the worker container. Defaults to UTC if not set.
# Use a TZ database name, e.g. "America/New_York" or "Europe/Paris".
TZ=
